# All settings are optional; these are the defaults. See README for rationale.
PORT=3000
LOG_LEVEL=info
# Set to true behind a load balancer so rate limiting sees the real client IP.
TRUST_PROXY=false

FETCH_TIMEOUT_MS=8000
MAX_SOURCE_BYTES=15728640
MAX_REDIRECTS=3
ALLOWED_PORTS=80,443
# Development only: allows fetching from localhost/private networks.
ALLOW_PRIVATE_NETWORKS=false

MAX_OUTPUT_DIMENSION=4096
MAX_INPUT_PIXELS=50000000
PROCESS_TIMEOUT_SECONDS=10

RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

OUTPUT_CACHE_MAX_BYTES=134217728
OUTPUT_CACHE_TTL_MS=3600000
SOURCE_CACHE_MAX_BYTES=67108864
SOURCE_CACHE_TTL_MS=300000
HTTP_CACHE_MAX_AGE_SECONDS=86400

# Defaults to the number of CPU cores.
# MAX_CONCURRENT_JOBS=4
MAX_QUEUED_JOBS=64
MAX_CONCURRENT_FETCHES=8
MAX_QUEUED_FETCHES=32
